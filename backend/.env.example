# TruthLens AI Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini API Key for Generative AI Explanations
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Path to Tesseract binary if installed on Windows
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Maximum Upload Size in Bytes (default 10MB)
MAX_UPLOAD_SIZE_BYTES=10485760
